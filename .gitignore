.gradle/
.kotlin/
**/build/
# WI-10: the bleTransport-on build (tools/ci.sh) writes to its own directory.
**/build-ble/
local.properties
# WI-12: release signing key material is read from the environment or this untracked file; never committed.
release-signing.properties
.idea/
*.iml
.DS_Store
*.jks
*.keystore
.env
.env.*
!.env.example
__pycache__/
*.py[cod]

# >>> cc-suite >>>
# cc-suite-schema: 8
# AI assistant local state
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/*.local.*
CLAUDE.local.md

# Codex CLI — local files, keep checked-in subdirs
.codex/*
!.codex/skills/
!.codex/prompts/
!.codex/hooks.json
!.codex/hooks.cc-suite.json
!.codex/config.toml

# cc-suite-managed symlinks (created by bridge_skills.sh) — derived, not authored
.claude/skills/cc-suite
.agents/skills

# Antigravity workspace MCP config is generated from .mcp.json and may contain
# credentials or machine-specific paths.
.agents/mcp_config.json
.agents/.cc-suite-mcp.provenance.json

# cc-suite tool-profile bridge (grok/opencode/qwen) — derived provenance
# sidecars tracking which MCP servers cc-suite owns. Not authored.
.cc-suite-*.provenance.json

# cc-suite local state — what init created, and the pre-bridge CLAUDE.md backup.
# Machine-local bookkeeping, not shared. Listed file-by-file on purpose:
# .cc-suite/agents/ holds declared advisors and IS meant to be committed.
.cc-suite/provenance
.cc-suite/original-claude.md
# Audit findings files written by /cc-suite:audit and the audit-fix loop —
# per-run working state (findings + fix statuses), not authored content.
.cc-suite/audits/

# AI assistant ephemeral state and machine-local artifacts
.claude/memory/
**/*.findings.json
.ai-artifacts/
# <<< cc-suite <<<

# >>> third-party material >>>
# The documents and supplied design material this project was built from are not
# shipped. Their records stay: rules/sources/*.md (URL, hash), rules/sources/text
# (extractions the tools read), and the manifests under design/.
rules/sources/*.pdf
rules/sources/*.doc
rules/sources/*.html
design/original/
# <<< third-party material <<<

# >>> agentic tools >>>
# No agent tooling is part of this project. Every agent directory and file is
# local to a machine, ignored here, and recreated by the tool that owns it; a
# fresh clone starts without them. Checkout-local AGENTS.md is ignored in
# .git/info/exclude instead, so the workspace rulebook stays outside git rather
# than being ignored per repository. CLAUDE.md is ignored here, in the tracked
# file: every checkout carries the workspace link, and .git/info/exclude does
# not travel to a fresh clone, where the link would show as untracked.
.claude/
.agents/
.codex/
.grok/
.cc-suite/
.cc-suite.md
.cc-suite-*.provenance.json
.mcp.json
opencode.json
CLAUDE.md

# Other agents this project does not use: ignore the whole directory. When one is
# adopted and its rules should be committed, add an explicit '!path' exception
# for that path rather than removing the rule.
.gemini/
.cursor/
.windsurf/
.continue/
.opencode/
.qwen/
.crush/
.amp/
.roo/
.cline/
.kiro/
.augment/
.devin/
.jules/
.trae/
.void/
.tabby/
.codeium/
.sourcegraph/
.supermaven/
.pieces/

# Aider writes its conversation history and tag cache beside the code it edits.
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
# <<< agentic tools <<<
